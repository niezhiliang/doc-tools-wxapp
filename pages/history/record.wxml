<van-notice-bar
    left-icon="volume-o"
    style="margin-top: 30rpx;border-radius: 10rpx;"
    text="{{noticeMsg}}"/>

<view wx:if="{{records.length == 0}}" class="empty-state">
  <van-empty description="暂无转换记录" image="search">
    <van-button type="primary" size="small" color="{{bgColor}}" bind:click="onChange" data-target="0">去转换</van-button>
  </van-empty>
</view>

<view class="record-list" wx:if="{{records.length > 0}}">
  <view wx:for="{{records}}" wx:for-item="record" wx:key="id"
    class="record-card"
    bind:tap="redirectToResult"
    data-id="{{record.id}}"
    data-type="{{record.convertType}}"
    data-status="{{record.convertStatus}}">
    <view class="record-thumb">
      <image src="{{record.convertTypeImg}}" mode="aspectFit" class="thumb-img" />
    </view>
    <view class="record-info">
      <view class="record-title">{{record.fileName}}</view>
      <view class="record-desc">{{record.appName}}</view>
      <view class="record-time">{{record.createTime}}</view>
    </view>
    <view class="record-status">
      <view class="status-tag status-{{record.convertStatus}}">
        {{typeEnum[record.convertStatus]}}
      </view>
    </view>
  </view>
</view>

<van-tabbar
  active="{{active}}"
  active-color="{{bgColor}}"
  inactive-color="#000"
  bind:change="onChange"
>
  <van-tabbar-item icon="home-o">首页</van-tabbar-item>
  <van-tabbar-item icon="notes-o">记录</van-tabbar-item>
</van-tabbar>

<van-toast id="van-toast" />
