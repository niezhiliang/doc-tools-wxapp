<view class="screen history-screen">
  <view class="section-head">
<view class="section-title">我的文件</view>
<text class="small-tag">最近 3 天</text>
</view>
  <view class="muted history-intro">未完成的任务也会保留在这里</view>
  <view class="error" wx:if="{{error}}">{{error}}<button class="secondary" bindtap="load">重新加载</button>
</view>
  <view wx:if="{{loading}}" class="empty">
<view class="spinner">
</view>
<view class="muted">正在查找转换记录</view>
</view>
  <view class="empty" wx:if="{{!loading && !error && !records.length}}">
<view class="empty-file">
<view class="file-icon tone-file">PDF</view>
</view>
<view class="section-title">还没有转换记录</view>
<view class="muted">从一份文件开始<view>转换进度和结果都会出现在这里</view>
</view>
<button class="secondary" bindtap="home">去转换文件</button>
</view>
  <button class="record-row" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
<view class="file-icon tone-{{item.targetTone}}">{{item.target}}</view>
<view class="file-copy">
<view class="filename">{{item.fileName}}</view>
<view class="record-meta">{{item.appName || item.source+'转'+item.target}}</view>
<view class="record-meta">{{item.createTime}}</view>
</view>
<view class="record-state">
<text class="status-{{item.convertStatus}}">{{labels[item.convertStatus]}}</text>
<view class="chevron">›</view>
</view>
</button>
  <view wx:if="{{!loading && records.length}}" class="footnote">显示近 3 天记录及未完成任务<view>转换结果请及时保存</view>
</view>
</view>
