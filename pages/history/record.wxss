page{background:#fff}
.history-intro{margin-top:-16rpx;margin-bottom:30rpx}
button.record-row[class]{display:flex;align-items:center;gap:22rpx;padding:30rpx 0;border-bottom:1rpx solid #f2f2f6;width:100%;text-align:left}
button.record-row[class] .file-icon{width:78rpx;height:88rpx;font-size:24rpx;border-radius:18rpx}
button.record-row[class] .filename{font-size:28rpx}
.record-meta{font-size:22rpx;color:#9696a2;margin-top:5rpx}
.record-state{text-align:right;flex-shrink:0;font-size:21rpx;color:#8e87bf}
.record-state .chevron{line-height:1.2;margin-top:6rpx}
.status-3{color:#40a782}
.status-4{color:#d58c53}
.empty-file{width:142rpx;height:142rpx;border-radius:50%;background:#f7f6fc;display:flex;align-items:center;justify-content:center;margin:auto}
.empty-file .file-icon{transform:rotate(-8deg)}
