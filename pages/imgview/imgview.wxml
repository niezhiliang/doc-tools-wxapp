<view class="drag-hint">
  <van-icon name="info-o" size="14" color="#969799" />
  <text class="hint-text">长按图片可拖动排序</text>
</view>

<view wx:if="{{!allUploaded}}" class="upload-progress-bar">
  <van-progress
    percentage="{{uploadTotal > 0 ? (uploadDone / uploadTotal * 100) : 0}}"
    color="{{bgColor}}"
    stroke-width="4" />
  <text class="progress-text">正在上传图片 {{uploadDone}}/{{uploadTotal}}</text>
</view>

<WxDragImg
  preview-size="{{dragSize}}"
  columns="{{3}}"
  gap="{{9}}"
  max-count="{{9}}"
  default-img-list="{{localPaths}}"
  bind:update-image-list="onDragUpdate">
</WxDragImg>

<view class="button-group">
  <van-button
    bind:click="onUpload"
    custom-class="custom-button"
    disabled="{{picObjList.length >= 9}}">添加图片</van-button>
  <van-button type="primary"
    bind:click="onConvert"
    custom-class="custom-button"
    color="{{bgColor}}"
    disabled="{{picObjList.length < 1 || !allUploaded}}"
    class="footer">图片生成PDF</van-button>
</view>
<van-toast id="van-toast" />
