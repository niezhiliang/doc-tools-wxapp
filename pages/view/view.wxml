    <van-card
        style="padding: 30rpx;"
        lazy-load="true"
        thumb="/imgs/file.png">
        <view slot="title"
        bind:tap="onPreView"
        class="van-card__title">
        {{fileName}}
        </view>
        <view slot="desc">
           <view>文件类型：{{fileType}}</view>
           <view>文件大小：{{fileSize}}</view>
        </view>
        <view slot="price" style="margin-bottom: 35rpx;">
            <van-progress
              color="{{uploadError ? '#ee0a24' : bgColor}}"
              percentage="{{percentage}}"
              stroke-width="6" />
            <view class="upload-status">
              <text wx:if="{{!uploadDone && !uploadError}}" class="status-uploading">上传中 {{percentage}}%</text>
              <text wx:if="{{uploadDone}}" class="status-done">上传完成</text>
              <text wx:if="{{uploadError}}" class="status-error">上传失败</text>
            </view>
        </view>
    </van-card>

    <van-button loading="{{loadStatus}}"
      type="primary"
      size="large"
      bind:click="onConvert"
      class="footer"
      custom-class="custom-button"
      color="{{bgColor}}"
      disabled="{{!uploadDone}}"
      loading-text="{{btnText}}">立即转换</van-button>
    <van-toast id="van-toast" />
