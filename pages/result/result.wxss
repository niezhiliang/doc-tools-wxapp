/* pages/result/result.wxss */

.custom-empty {
    margin-top: 50rpx !important;
}
.custom-empty .van-empty__image {
    width: 80px;
    height: 80px;
}
.custom-empty .van-empty__description {
    color: black;
    font-size: 20px;
}

.file-info-card {
    margin-top: 20rpx;
    padding: 0 40rpx;
    width: 100%;
}
.file-info-item {
    display: flex;
    align-items: baseline;
    gap: 12rpx;
    padding: 8rpx 0;
}
.file-info-label {
    font-size: 24rpx;
    color: #969799;
    flex-shrink: 0;
}
.file-info-value {
    font-size: 24rpx;
    color: #323233;
}
.file-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.button-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 60rpx;
    padding: 0 40rpx;
}

.action-button {
    width: 100%;
    margin-bottom: 24rpx;
}
