page{background:#fff}
.home-screen{padding-top:40rpx}
.tools{display:flex;flex-wrap:wrap;width:100%}
button.tool[class]{flex:0 0 25%;width:25%;min-width:0;margin:0;padding:8rpx 0 28rpx;background:transparent}
.tool-name{font-size:24rpx;white-space:nowrap;margin-top:14rpx;font-weight:400}
.quick-heading{margin-top:58rpx}
button.upload-zone[class]{width:100%;margin:0;min-height:360rpx;border:2rpx dashed #a29cf4;border-radius:26rpx;background:#f2f1ff;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:34rpx 16rpx}
.upload-symbol{width:76rpx;height:68rpx;background:#655aee;color:#fff;border-radius:24rpx;font-size:54rpx;line-height:64rpx;font-weight:500;box-shadow:0 10rpx 24rpx #655aee22}
.upload-title{font-size:33rpx;font-weight:600;margin:24rpx 0 8rpx}
.upload-link{color:#6259df;font-size:26rpx;margin-top:26rpx}
.upload-link text{margin-left:14rpx}
button.history-entry[class]{width:100%;margin-left:0;margin-right:0;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:36rpx 0;border-bottom:1rpx solid #f1f1f5;margin-top:18rpx}
button.history-entry[class] .muted{margin-top:6rpx}
