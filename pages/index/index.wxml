<view class="screen home-screen">
  <view class="section-head">
<view class="section-title">常用功能</view>
<text class="small-tag">限时免费</text>
</view>
  <view wx:if="{{loading}}" class="empty compact">
<view class="spinner">
</view>
<view class="muted">正在加载转换工具</view>
</view>
  <view wx:elif="{{error}}" class="notice">
<view>{{error}}</view>
<button class="secondary" bindtap="load">重新加载</button>
</view>
  <view wx:else class="tools">
    <button class="tool" wx:for="{{tools}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="file-pair">
<view class="file-icon small back tone-{{item.sourceTone}}">{{item.source}}</view>
<view class="file-icon small front tone-{{item.targetTone}}">{{item.target}}</view>
</view>
      <view class="tool-name">{{item.appName}}</view>
    </button>
  </view>
  <block wx:if="{{!loading && !error}}">
    <view class="section-head quick-heading">
<view class="section-title">快捷入口</view>
</view>
    <button class="upload-zone" wx:for="{{tools}}" wx:key="id" wx:if="{{item.id == 6}}" data-id="{{item.id}}" bindtap="open">
      <view class="upload-symbol">↑</view>
<view class="upload-title">图片，轻松合成 PDF</view>
      <view class="muted">微信图片、手机相册、拍照导入</view>
<view class="upload-link">选择图片 <text>→</text>
</view>
    </button>
    <button class="history-entry" bindtap="history">
<view>
<view class="body-title">我的转换记录</view>
<view class="muted">查看进度，找回转换后的文件</view>
</view>
<text class="chevron">›</text>
</button>
    <view class="footnote">选好文件，剩下的交给我们</view>
  </block>
</view>
